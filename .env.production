# Production Environment Variables for powerhealthcareit.com
# Copy these variables to your Azure Container App environment settings

# Domain Configuration
DJANGO_ALLOWED_HOSTS=powerhealthcareit.com,www.powerhealthcareit.com,*.azurecontainerapps.io,localhost,127.0.0.1
REACT_APP_API_URL=https://powerhealthcareit.com
REACT_APP_WS_URL=wss://powerhealthcareit.com

# Site Configuration
SITE_URL=https://powerhealthcareit.com
FRONTEND_URL=https://powerhealthcareit.com

# CORS Settings (handled in Django settings)
CORS_ALLOW_ALL_ORIGINS=False

# SSL/Security Settings
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Email Configuration (update if needed)
DEFAULT_FROM_EMAIL=noreply@powerhealthcareit.com
SERVER_EMAIL=admin@powerhealthcareit.com

# Additional Security Headers
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
