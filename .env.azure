# Azure Environment Variables
# Copy this to .env for local development with Azure services

# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_SETTINGS_MODULE=poehr_scheduling_backend.settings_azure

# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_RESOURCE_GROUP=poehr-scheduling-rg
AZURE_KEYVAULT_NAME=poehr-scheduling-kv

# Database Configuration (Azure Database for PostgreSQL)
DB_NAME=poehr_db
DB_USER=poehr_admin
DB_HOST=poehr-scheduling-postgres.postgres.database.azure.com
DB_PORT=5432
DB_PASSWORD=your-secure-database-password

# Redis Configuration (Azure Cache for Redis)
REDIS_HOST=poehr-scheduling-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-access-key

# Email Configuration
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Stripe Configuration (Live keys - configure in Azure Key Vault)
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_51NAPxIFfk7zi0PnMkHSzOMJqYkoAmAHx8HB0m5Gcc27a1o8H7dxPiyI4fmuFvNE1W1tEGgcwBG6mCRI0AHCkeGwG00qNkmyLba
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for subscription tiers
STRIPE_BASIC_PRICE_ID=price_1RwC4aFfk7zi0PnMzpA9gILD
STRIPE_PREMIUM_PRICE_ID=price_1RwC59Ffk7zi0PnM0oOnjBmn
STRIPE_ENTERPRISE_PRICE_ID=price_1RwC60Ffk7zi0PnM7vmJn3P1

# Container Apps Configuration
CONTAINER_APP_NAME=poehr-scheduling
AZURE_LOCATION=eastus
