FROM node:18-alpine as frontend-build

# Build React frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci --only=production
COPY frontend/ ./
RUN echo "=== BUILDING FRONTEND ===" && \
    npm run build && \
    echo "=== FRONTEND BUILD COMPLETE ===" && \
    ls -la build/ && \
    echo "=== CHECKING INDEX.HTML ===" && \
    head -10 build/index.html

# Python backend stage
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=poehr_scheduling_backend.settings_azure_env

WORKDIR /code

# Install system dependencies for Azure
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-client \
        build-essential \
        libpq-dev \
        curl \
        wget \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.azure.txt /code/
RUN pip install --no-cache-dir -r requirements.azure.txt \
    && pip install --no-cache-dir gunicorn \
    && pip install --no-cache-dir uvicorn[standard] \
    && pip list | grep -E "(channels|uvicorn|redis|azure)" || echo "WARNING: Dependencies verification needed"

# Copy project
COPY . /code/

# Verify WebSocket and Azure dependencies are installed
RUN python verify_azure_deps.py || echo "⚠️ Azure dependency verification failed"

# Copy built frontend from previous stage
COPY --from=frontend-build /frontend/build /code/static/frontend/

# Debug: Verify frontend files were copied
RUN echo "=== CHECKING COPIED FRONTEND FILES ===" && \
    ls -la /code/static/frontend/ && \
    echo "=== CHECKING INDEX.HTML IN STATIC ===" && \
    head -10 /code/static/frontend/index.html && \
    echo "=== SEARCHING FOR DEPLOYMENT TEST TEXT ===" && \
    grep -r "DEPLOYMENT.*TEST" /code/static/frontend/ || echo "DEPLOYMENT TEST NOT FOUND IN CONTAINER!" && \
    echo "=== CONTAINER BUILD TIMESTAMP ===" && \
    echo "Built at: $(date)" > /code/static/frontend/build-info.txt

# Create staticfiles directory
RUN mkdir -p /code/staticfiles

# Collect static files with temporary secret key for build
ENV DJANGO_SECRET_KEY='temporary-build-time-key-do-not-use-in-production'
RUN python manage.py collectstatic --noinput --settings=poehr_scheduling_backend.settings_azure_env || \
    echo "Warning: Static files collection failed during build. Will retry at runtime."

# Create initialization script for Azure
RUN echo '#!/bin/bash\npython manage.py migrate --noinput\npython manage.py create_admin\nexec "$@"' > /code/init.sh && chmod +x /code/init.sh

# Clear the temporary secret key
ENV DJANGO_SECRET_KEY=

# Copy Azure startup script
COPY startup-azure.sh /code/
RUN chmod +x /code/startup-azure.sh

# Create a test file to verify container build
RUN echo "Container built successfully at: $(date)" > /code/static/frontend/container-build.txt

# Verify static files were collected and frontend files are present
RUN echo "=== STATIC FILES CHECK ===" && \
    ls -la /code/staticfiles/ || echo "No staticfiles directory" && \
    echo "=== FRONTEND STATIC FILES ===" && \
    ls -la /code/static/frontend/ || echo "No frontend directory" && \
    echo "=== SEARCHING FOR DEPLOYMENT TEST IN STATIC FILES ===" && \
    find /code -name "*.js" -exec grep -l "DEPLOYMENT.*TEST" {} \; 2>/dev/null || echo "No DEPLOYMENT TEST found in any JS files"

# Expose port
EXPOSE 8080

# Try direct uvicorn command instead of script
CMD ["uvicorn", "poehr_scheduling_backend.asgi:application", "--host", "0.0.0.0", "--port", "8080", "--log-level", "info"]
